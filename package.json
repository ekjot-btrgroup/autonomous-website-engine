{
  "name": "autonomous-website-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reference library (Framer templates) -> brand brief -> 10 original homepage designs -> user picks 3 -> final client-ready designs (HTML or Lovable).",
  "scripts": {
    "setup": "node engine/setup.mjs",
    "sync": "node engine/release.mjs sync",
    "remember": "node engine/remember.mjs",
    "push": "node engine/sync.mjs push",
    "pull": "node engine/sync.mjs pull",
    "release": "node engine/release.mjs release",
    "releases": "node engine/release.mjs releases",
    "status": "node engine/status.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "capture": "node engine/capture.mjs",
    "slop": "node engine/slop.mjs",
    "refs": "node engine/refs.mjs",
    "directions": "node engine/directions.mjs",
    "review": "node engine/review.mjs",
    "final": "node engine/final.mjs",
    "photos": "python3 -I engine/tools/photos.py"
  },
  "engines": {
    "node": ">=20"
  }
}
