{
  "name": "autonomous-website-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Low-cost design library -> shortlist -> Lovable site engine. Scripts do the work; Claude only tags, writes briefs, picks colours/fonts and writes copy.",
  "scripts": {
    "setup": "node engine/setup.mjs",
    "sync": "node engine/release.mjs sync",
    "add": "node engine/add-designs.mjs",
    "import:pages": "python3 -I engine/tools/html_page.py",
    "tag": "node engine/tag.mjs",
    "shortlist": "node engine/shortlist.mjs",
    "sheet": "node engine/sheet.mjs",
    "site": "node engine/site.mjs",
    "export": "node engine/export.mjs",
    "remember": "node engine/remember.mjs",
    "push": "node engine/sync.mjs push",
    "pull": "node engine/sync.mjs pull",
    "release": "node engine/release.mjs release",
    "releases": "node engine/release.mjs releases",
    "status": "node engine/status.mjs",
    "usage": "node engine/usage.mjs",
    "showcase:init": "node engine/showcase.mjs init",
    "showcase:check": "node engine/showcase.mjs check",
    "showcase:serve": "node engine/showcase.mjs serve",
    "test": "node --test tests/unit/*.test.mjs",
    "capture": "node engine/capture.mjs",
    "slop": "node engine/slop.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
